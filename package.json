{
  "name": "sphere-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "test": "node --test scripts/seed.test.mjs scripts/export.test.mjs",
    "test:gpu": "node scripts/test-gpu.mjs",
    "test:culling": "node scripts/test-culling.mjs",
    "test:lighting": "node scripts/test-lighting.mjs && node scripts/test-shadow.mjs",
    "test:export": "node scripts/test-path-tracer.mjs && node scripts/test-export-workflow.mjs",
    "test:print": "node scripts/test-print-size.mjs"
  },
  "dependencies": {
    "three": "^0.185.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "wabt": "^1.0.37",
    "playwright": "^1.55.0"
  }
}
